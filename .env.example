DATABASE_URL=postgresql://jobapply:local-development-only@localhost:5432/jobapply
APP_ORIGIN=http://localhost:3000
PORT=3000
PILOT_EMAIL=you@example.com
# Generate with npm run password:hash (see README); never put your password here.
PILOT_PASSWORD_HASH=
# All provider secrets stay on the server. P1 capture requires no provider credentials.
OPENAI_API_KEY=
OPENAI_SOL_MODEL=gpt-6.1-sol
OPENAI_LUNA_MODEL=gpt-6-luna
# Answer bank (issue 006): Luna equivalence threshold; empty uses the 0.85 placeholder.
# Set it from `npm run answers:calibrate -- --live`.
ANSWER_EQUIVALENCE_THRESHOLD=
# Eligibility replay cost rates (USD per million tokens), used only by `npm run eligibility:replay`.
OPENAI_SOL_INPUT_USD_PER_MTOK=
OPENAI_SOL_OUTPUT_USD_PER_MTOK=
# Outreach (issues 010-012). All optional at boot: a missing value pauses outreach on a
# provider_limit ticket instead of crashing. Apollo master API key (server only).
APOLLO_API_KEY=
# Gmail sender (also the From address) and its 16-character app password (needs 2-Step Verification).
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
# Implicit TLS; defaults shown.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
# Whole-session timeout; no reply after the message data marks delivery uncertain.
GMAIL_SMTP_TIMEOUT_MS=30000
# Rolling 24-hour cap on outreach emails, well below Gmail's personal-account limit.
OUTREACH_DAILY_EMAIL_LIMIT=20
# Embedded PostgreSQL directory for `npm run dev:local` (default .data/postgres).
LOCAL_DATABASE_PATH=

{
  "name": "jobapply",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json && node scripts/copy-schema.mjs",
    "start": "node dist/server/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "password:hash": "node --import tsx scripts/hash-password.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "dev:local": "node --env-file-if-exists=.env --import tsx scripts/local.ts",
    "answers:calibrate": "node --env-file-if-exists=.env --import tsx scripts/answers-calibrate.ts",
    "eligibility:replay": "node --env-file-if-exists=.env --import tsx scripts/eligibility-replay.ts",
    "format": "prettier --write src scripts tests extension *.json *.ts index.html"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
